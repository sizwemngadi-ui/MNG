#property strict
#property copyright "Generated by Codex"
#property version   "1.00"
#property description "Detects market structure: HH/HL, LH/LL and trend changes."
#property indicator_chart_window
#property indicator_buffers 7
#property indicator_plots   6

#property indicator_label1  "Higher High"
#property indicator_type1   DRAW_ARROW
#property indicator_color1  clrLime
#property indicator_width1  1

#property indicator_label2  "Higher Low"
#property indicator_type2   DRAW_ARROW
#property indicator_color2  clrDodgerBlue
#property indicator_width2  1

#property indicator_label3  "Lower High"
#property indicator_type3   DRAW_ARROW
#property indicator_color3  clrOrangeRed
#property indicator_width3  1

#property indicator_label4  "Lower Low"
#property indicator_type4   DRAW_ARROW
#property indicator_color4  clrMagenta
#property indicator_width4  1

#property indicator_label5  "Trend Change Up"
#property indicator_type5   DRAW_ARROW
#property indicator_color5  clrDeepSkyBlue
#property indicator_width5  2

#property indicator_label6  "Trend Change Down"
#property indicator_type6   DRAW_ARROW
#property indicator_color6  clrTomato
#property indicator_width6  2

input int    SwingStrength      = 3;     // Bars on each side needed to confirm a swing
input double PointTolerance     = 10.0;  // Equality tolerance in points
input int    MarkerOffsetPoints = 30;    // Visual offset in points for markers

double HHBuffer[];
double HLBuffer[];
double LHBuffer[];
double LLBuffer[];
double TrendChangeUpBuffer[];
double TrendChangeDownBuffer[];
double TrendStateBuffer[]; // 1 = uptrend, -1 = downtrend, 0 = undefined

double ToleranceInPrice()
{
   return(PointTolerance * _Point);
}

bool IsSwingHigh(const int index, const int rates_total, const double &high[])
{
   const double pivot = high[index];
   for(int k = 1; k <= SwingStrength; ++k)
   {
      if(index - k < 0 || index + k >= rates_total)
         return(false);

      // Tie-breaker keeps one pivot for equal highs.
      if(high[index + k] >= pivot || high[index - k] > pivot)
         return(false);
   }
   return(true);
}

bool IsSwingLow(const int index, const int rates_total, const double &low[])
{
   const double pivot = low[index];
   for(int k = 1; k <= SwingStrength; ++k)
   {
      if(index - k < 0 || index + k >= rates_total)
         return(false);

      // Tie-breaker keeps one pivot for equal lows.
      if(low[index + k] <= pivot || low[index - k] < pivot)
         return(false);
   }
   return(true);
}

int OnInit()
{
   if(SwingStrength < 1)
   {
      Print("SwingStrength must be >= 1.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   SetIndexBuffer(0, HHBuffer, INDICATOR_DATA);
   SetIndexBuffer(1, HLBuffer, INDICATOR_DATA);
   SetIndexBuffer(2, LHBuffer, INDICATOR_DATA);
   SetIndexBuffer(3, LLBuffer, INDICATOR_DATA);
   SetIndexBuffer(4, TrendChangeUpBuffer, INDICATOR_DATA);
   SetIndexBuffer(5, TrendChangeDownBuffer, INDICATOR_DATA);
   SetIndexBuffer(6, TrendStateBuffer, INDICATOR_CALCULATIONS);

   PlotIndexSetInteger(0, PLOT_ARROW, 217); // Up triangle
   PlotIndexSetInteger(1, PLOT_ARROW, 241); // Up arrow
   PlotIndexSetInteger(2, PLOT_ARROW, 218); // Down triangle
   PlotIndexSetInteger(3, PLOT_ARROW, 242); // Down arrow
   PlotIndexSetInteger(4, PLOT_ARROW, 233); // Up signal
   PlotIndexSetInteger(5, PLOT_ARROW, 234); // Down signal

   for(int plot = 0; plot < 6; ++plot)
      PlotIndexSetDouble(plot, PLOT_EMPTY_VALUE, EMPTY_VALUE);

   IndicatorSetString(INDICATOR_SHORTNAME, "MarketStructureTrend(HH/HL/LH/LL)");
   return(INIT_SUCCEEDED);
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if(rates_total < (SwingStrength * 2 + 5))
      return(0);

   const double tolerance = ToleranceInPrice();
   const double offset = MarkerOffsetPoints * _Point;

   for(int i = 0; i < rates_total; ++i)
   {
      HHBuffer[i] = EMPTY_VALUE;
      HLBuffer[i] = EMPTY_VALUE;
      LHBuffer[i] = EMPTY_VALUE;
      LLBuffer[i] = EMPTY_VALUE;
      TrendChangeUpBuffer[i] = EMPTY_VALUE;
      TrendChangeDownBuffer[i] = EMPTY_VALUE;
      TrendStateBuffer[i] = 0.0;
   }

   bool hasLastHigh = false;
   bool hasLastLow = false;
   double lastHigh = 0.0;
   double lastLow = 0.0;

   int latestHighStructure = 0; // 1 = HH, -1 = LH
   int latestLowStructure = 0;  // 1 = HL, -1 = LL
   int trend = 0;               // 1 = uptrend, -1 = downtrend

   // Process oldest -> newest (timeseries arrays are indexed newest at 0).
   for(int i = rates_total - SwingStrength - 1; i >= SwingStrength + 1; --i)
   {
      if(IsSwingHigh(i, rates_total, high))
      {
         if(hasLastHigh)
         {
            if(high[i] > lastHigh + tolerance)
            {
               HHBuffer[i] = high[i] + offset;
               latestHighStructure = 1;
            }
            else if(high[i] < lastHigh - tolerance)
            {
               LHBuffer[i] = high[i] + offset;
               latestHighStructure = -1;
            }
         }
         hasLastHigh = true;
         lastHigh = high[i];
      }

      if(IsSwingLow(i, rates_total, low))
      {
         if(hasLastLow)
         {
            if(low[i] > lastLow + tolerance)
            {
               HLBuffer[i] = low[i] - offset;
               latestLowStructure = 1;
            }
            else if(low[i] < lastLow - tolerance)
            {
               LLBuffer[i] = low[i] - offset;
               latestLowStructure = -1;
            }
         }
         hasLastLow = true;
         lastLow = low[i];
      }

      int newTrend = trend;
      if(latestHighStructure == 1 && latestLowStructure == 1)
         newTrend = 1;
      else if(latestHighStructure == -1 && latestLowStructure == -1)
         newTrend = -1;

      if(newTrend != trend)
      {
         // Draw a trend-change marker only after an initial trend has been established.
         if(trend != 0)
         {
            if(newTrend == 1)
               TrendChangeUpBuffer[i] = low[i] - (offset * 1.5);
            else if(newTrend == -1)
               TrendChangeDownBuffer[i] = high[i] + (offset * 1.5);
         }
         trend = newTrend;
      }

      TrendStateBuffer[i] = trend;
   }

   // The most recent bars cannot form confirmed swings yet; carry latest trend state.
   for(int i = SwingStrength; i >= 0; --i)
      TrendStateBuffer[i] = trend;

   return(rates_total);
}
