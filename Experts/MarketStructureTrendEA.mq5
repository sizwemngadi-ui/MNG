#property strict
#property copyright "Generated by Codex"
#property version   "1.00"
#property description "EA that uses market structure trend-change signals."

#include <Trade/Trade.mqh>

enum TrendSignal
{
   SIGNAL_NONE = 0,
   SIGNAL_UP = 1,
   SIGNAL_DOWN = -1
};

input string IndicatorPath       = "MarketStructureTrend"; // Compiled indicator name/path for iCustom
input int    SwingStrength       = 3;
input double PointTolerance      = 10.0;
input int    MarkerOffsetPoints  = 30;

input bool   EnableAlerts        = true;
input bool   EnableTrading       = true;
input bool   ReverseOnSignal     = true;  // Close opposite positions when new signal appears
input double Lots                = 0.10;
input int    StopLossPoints      = 300;   // 0 = disabled
input int    TakeProfitPoints    = 600;   // 0 = disabled
input ulong  MagicNumber         = 55001;

CTrade trade;
int indicatorHandle = INVALID_HANDLE;
datetime lastBarTime = 0;

int NormalizeTrendValue(const double value)
{
   if(value > 0.5)
      return(1);
   if(value < -0.5)
      return(-1);
   return(0);
}

string TrendName(const int trend)
{
   if(trend > 0)
      return("UPTREND");
   if(trend < 0)
      return("DOWNTREND");
   return("NO_TREND");
}

bool IsNewBar()
{
   const datetime currentBarTime = iTime(_Symbol, _Period, 0);
   if(currentBarTime == 0)
      return(false);

   if(currentBarTime == lastBarTime)
      return(false);

   lastBarTime = currentBarTime;
   return(true);
}

TrendSignal ReadTrendChangeSignal(int &previousTrend, int &currentTrend)
{
   previousTrend = 0;
   currentTrend = 0;

   double trendValues[2];
   // Buffer 6 is TrendStateBuffer from the indicator.
   // shift 1 = last closed bar, shift 2 = previous closed bar.
   if(CopyBuffer(indicatorHandle, 6, 1, 2, trendValues) < 2)
      return(SIGNAL_NONE);

   currentTrend = NormalizeTrendValue(trendValues[0]);
   previousTrend = NormalizeTrendValue(trendValues[1]);

   // Alert/trade only when trend flips between confirmed up/down states.
   if(currentTrend == previousTrend || currentTrend == 0 || previousTrend == 0)
      return(SIGNAL_NONE);

   if(currentTrend > previousTrend)
      return(SIGNAL_UP);
   return(SIGNAL_DOWN);
}

bool HasPosition(const ENUM_POSITION_TYPE positionType)
{
   for(int i = PositionsTotal() - 1; i >= 0; --i)
   {
      const ulong ticket = PositionGetTicket(i);
      if(ticket == 0 || !PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == positionType)
         return(true);
   }

   return(false);
}

void ClosePositions(const ENUM_POSITION_TYPE positionType)
{
   for(int i = PositionsTotal() - 1; i >= 0; --i)
   {
      const ulong ticket = PositionGetTicket(i);
      if(ticket == 0 || !PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != positionType)
         continue;

      if(!trade.PositionClose(ticket))
      {
         PrintFormat("Failed to close position %I64u. Error: %d", ticket, GetLastError());
      }
   }
}

void OpenBuy()
{
   double sl = 0.0;
   double tp = 0.0;

   if(StopLossPoints > 0)
      sl = SymbolInfoDouble(_Symbol, SYMBOL_ASK) - StopLossPoints * _Point;
   if(TakeProfitPoints > 0)
      tp = SymbolInfoDouble(_Symbol, SYMBOL_ASK) + TakeProfitPoints * _Point;

   if(!trade.Buy(Lots, _Symbol, 0.0, sl, tp, "TrendChange BUY"))
      PrintFormat("Buy order failed. Error: %d", GetLastError());
}

void OpenSell()
{
   double sl = 0.0;
   double tp = 0.0;

   if(StopLossPoints > 0)
      sl = SymbolInfoDouble(_Symbol, SYMBOL_BID) + StopLossPoints * _Point;
   if(TakeProfitPoints > 0)
      tp = SymbolInfoDouble(_Symbol, SYMBOL_BID) - TakeProfitPoints * _Point;

   if(!trade.Sell(Lots, _Symbol, 0.0, sl, tp, "TrendChange SELL"))
      PrintFormat("Sell order failed. Error: %d", GetLastError());
}

void ExecuteSignal(const TrendSignal signal)
{
   if(signal == SIGNAL_UP)
   {
      if(ReverseOnSignal)
         ClosePositions(POSITION_TYPE_SELL);
      if(!HasPosition(POSITION_TYPE_BUY))
         OpenBuy();
   }
   else if(signal == SIGNAL_DOWN)
   {
      if(ReverseOnSignal)
         ClosePositions(POSITION_TYPE_BUY);
      if(!HasPosition(POSITION_TYPE_SELL))
         OpenSell();
   }
}

int OnInit()
{
   trade.SetExpertMagicNumber((long)MagicNumber);
   trade.SetDeviationInPoints(20);

   indicatorHandle = iCustom(_Symbol,
                             _Period,
                             IndicatorPath,
                             SwingStrength,
                             PointTolerance,
                             MarkerOffsetPoints);

   if(indicatorHandle == INVALID_HANDLE)
   {
      PrintFormat("Failed to create indicator handle '%s'. Error: %d",
                  IndicatorPath,
                  GetLastError());
      return(INIT_FAILED);
   }

   lastBarTime = iTime(_Symbol, _Period, 0);
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   if(indicatorHandle != INVALID_HANDLE)
      IndicatorRelease(indicatorHandle);
}

void OnTick()
{
   if(!IsNewBar())
      return;

   int previousTrend = 0;
   int currentTrend = 0;
   const TrendSignal signal = ReadTrendChangeSignal(previousTrend, currentTrend);
   if(signal == SIGNAL_NONE)
      return;

   const string message = StringFormat("%s %s %s trend change detected: %s -> %s",
                                       TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS),
                                       _Symbol,
                                       EnumToString(_Period),
                                       TrendName(previousTrend),
                                       TrendName(currentTrend));

   Print(message);
   if(EnableAlerts)
      Alert(message);

   if(EnableTrading)
      ExecuteSignal(signal);
}
