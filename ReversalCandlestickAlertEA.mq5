#property copyright "Generated by Cursor"
#property version   "1.00"
#property strict

input bool InpEnablePopupAlert       = true;
input bool InpEnablePushNotification = false;
input bool InpDetectBullishEngulfing = true;
input bool InpDetectBearishEngulfing = true;
input bool InpDetectHammer           = true;
input bool InpDetectShootingStar     = true;
input bool InpDetectDoji             = false;
input double InpDojiBodyPercent      = 10.0;
input color InpBullishLineColor      = clrLimeGreen;
input color InpBearishLineColor      = clrTomato;
input color InpNeutralLineColor      = clrGoldenrod;
input ENUM_LINE_STYLE InpLineStyle   = STYLE_DOT;
input int InpLineWidth               = 1;
input string InpLinePrefix           = "REVERSAL_";

datetime g_lastProcessedBarTime = 0;
datetime g_lastSignalBarTime    = 0;

bool IsBullishEngulfing(const MqlRates &current, const MqlRates &previous)
{
   const bool currentBullish = (current.close > current.open);
   const bool previousBearish = (previous.close < previous.open);
   if(!currentBullish || !previousBearish)
      return false;

   const bool bodyEngulfs = (current.open <= previous.close && current.close >= previous.open);
   const double currentBody = MathAbs(current.close - current.open);
   const double previousBody = MathAbs(previous.close - previous.open);
   return (bodyEngulfs && currentBody >= previousBody);
}

bool IsBearishEngulfing(const MqlRates &current, const MqlRates &previous)
{
   const bool currentBearish = (current.close < current.open);
   const bool previousBullish = (previous.close > previous.open);
   if(!currentBearish || !previousBullish)
      return false;

   const bool bodyEngulfs = (current.open >= previous.close && current.close <= previous.open);
   const double currentBody = MathAbs(current.close - current.open);
   const double previousBody = MathAbs(previous.close - previous.open);
   return (bodyEngulfs && currentBody >= previousBody);
}

bool IsHammer(const MqlRates &bar)
{
   const double range = bar.high - bar.low;
   if(range <= 0.0)
      return false;

   const double body = MathAbs(bar.close - bar.open);
   const double upperWick = bar.high - MathMax(bar.open, bar.close);
   const double lowerWick = MathMin(bar.open, bar.close) - bar.low;

   return (lowerWick >= (2.0 * body) &&
           upperWick <= body &&
           MathMin(bar.open, bar.close) >= (bar.low + range * 0.55));
}

bool IsShootingStar(const MqlRates &bar)
{
   const double range = bar.high - bar.low;
   if(range <= 0.0)
      return false;

   const double body = MathAbs(bar.close - bar.open);
   const double upperWick = bar.high - MathMax(bar.open, bar.close);
   const double lowerWick = MathMin(bar.open, bar.close) - bar.low;

   return (upperWick >= (2.0 * body) &&
           lowerWick <= body &&
           MathMax(bar.open, bar.close) <= (bar.low + range * 0.45));
}

bool IsDoji(const MqlRates &bar)
{
   const double range = bar.high - bar.low;
   if(range <= 0.0)
      return false;

   const double body = MathAbs(bar.close - bar.open);
   return (body <= (range * (InpDojiBodyPercent / 100.0)));
}

void AppendPattern(string &patterns, const string pattern)
{
   if(StringLen(patterns) > 0)
      patterns += ", ";
   patterns += pattern;
}

bool DetectReversalPatterns(const int shift, string &patterns, int &direction)
{
   patterns = "";
   direction = 0;

   MqlRates bars[2];
   ArraySetAsSeries(bars, true);
   const int copied = CopyRates(_Symbol, _Period, shift, 2, bars);
   if(copied < 2)
      return false;

   const MqlRates current = bars[0];
   const MqlRates previous = bars[1];

   bool bullish = false;
   bool bearish = false;
   bool neutral = false;

   if(InpDetectBullishEngulfing && IsBullishEngulfing(current, previous))
   {
      AppendPattern(patterns, "Bullish Engulfing");
      bullish = true;
   }

   if(InpDetectBearishEngulfing && IsBearishEngulfing(current, previous))
   {
      AppendPattern(patterns, "Bearish Engulfing");
      bearish = true;
   }

   if(InpDetectHammer && IsHammer(current))
   {
      AppendPattern(patterns, "Hammer");
      bullish = true;
   }

   if(InpDetectShootingStar && IsShootingStar(current))
   {
      AppendPattern(patterns, "Shooting Star");
      bearish = true;
   }

   if(InpDetectDoji && IsDoji(current))
   {
      AppendPattern(patterns, "Doji");
      neutral = true;
   }

   if(StringLen(patterns) == 0)
      return false;

   if((bullish && bearish) || neutral)
      direction = 0;
   else if(bullish)
      direction = 1;
   else if(bearish)
      direction = -1;

   return true;
}

void DrawSignalLine(const datetime barTime, const int direction)
{
   const string name = InpLinePrefix + IntegerToString((int)barTime);
   if(ObjectFind(0, name) >= 0)
      return;

   if(!ObjectCreate(0, name, OBJ_VLINE, 0, barTime, 0.0))
   {
      PrintFormat("Failed to create vertical line. Error=%d", GetLastError());
      return;
   }

   color lineColor = InpNeutralLineColor;
   if(direction > 0)
      lineColor = InpBullishLineColor;
   else if(direction < 0)
      lineColor = InpBearishLineColor;

   ObjectSetInteger(0, name, OBJPROP_COLOR, lineColor);
   ObjectSetInteger(0, name, OBJPROP_STYLE, InpLineStyle);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, InpLineWidth);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
}

void NotifySignal(const string patterns, const datetime barTime, const int direction)
{
   string directionLabel = "Neutral";
   if(direction > 0)
      directionLabel = "Bullish";
   else if(direction < 0)
      directionLabel = "Bearish";

   const string message = StringFormat("%s reversal on %s %s (%s): %s",
                                       directionLabel,
                                       _Symbol,
                                       EnumToString(_Period),
                                       TimeToString(barTime, TIME_DATE | TIME_MINUTES),
                                       patterns);

   Print(message);
   if(InpEnablePopupAlert)
      Alert(message);

   if(InpEnablePushNotification)
   {
      if(!SendNotification(message))
         PrintFormat("SendNotification failed. Error=%d", GetLastError());
   }
}

int OnInit()
{
   Print("ReversalCandlestickAlertEA initialized");
   return INIT_SUCCEEDED;
}

void OnTick()
{
   const datetime closedBarTime = iTime(_Symbol, _Period, 1);
   if(closedBarTime <= 0)
      return;

   if(closedBarTime == g_lastProcessedBarTime)
      return;

   g_lastProcessedBarTime = closedBarTime;

   string patterns;
   int direction = 0;
   if(!DetectReversalPatterns(1, patterns, direction))
      return;

   if(g_lastSignalBarTime == closedBarTime)
      return;

   g_lastSignalBarTime = closedBarTime;
   DrawSignalLine(closedBarTime, direction);
   NotifySignal(patterns, closedBarTime, direction);
}
