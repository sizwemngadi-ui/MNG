#property copyright "Generated by Codex"
#property version   "1.00"
#property strict

input ENUM_TIMEFRAMES   InpTimeframe         = PERIOD_CURRENT;
input int               InpForcePeriod       = 13;
input ENUM_MA_METHOD    InpMaMethod          = MODE_SMA;
input ENUM_APPLIED_VOLUME InpVolumeType      = VOLUME_TICK;
input double            InpTriggerValue      = 0.0;
input bool              InpEnableAlerts      = true;
input color             InpLineColor         = clrTomato;
input ENUM_LINE_STYLE   InpLineStyle         = STYLE_DOT;
input int               InpLineWidth         = 1;
input ENUM_BASE_CORNER  InpMonitorCorner     = CORNER_LEFT_UPPER;
input int               InpMonitorX          = 12;
input int               InpMonitorY          = 24;

int      g_forceHandle = INVALID_HANDLE;
datetime g_lastAlertBarTime = 0;
string   g_monitorName = "ForceIndexMonitorLabel";
string   g_linePrefix  = "ForceIndexTriggerLine_";

ENUM_TIMEFRAMES ResolveTimeframe()
{
   if(InpTimeframe == PERIOD_CURRENT)
      return((ENUM_TIMEFRAMES)_Period);
   return(InpTimeframe);
}

string TimeframeToString(const ENUM_TIMEFRAMES timeframe)
{
   switch(timeframe)
   {
      case PERIOD_M1:   return "M1";
      case PERIOD_M2:   return "M2";
      case PERIOD_M3:   return "M3";
      case PERIOD_M4:   return "M4";
      case PERIOD_M5:   return "M5";
      case PERIOD_M6:   return "M6";
      case PERIOD_M10:  return "M10";
      case PERIOD_M12:  return "M12";
      case PERIOD_M15:  return "M15";
      case PERIOD_M20:  return "M20";
      case PERIOD_M30:  return "M30";
      case PERIOD_H1:   return "H1";
      case PERIOD_H2:   return "H2";
      case PERIOD_H3:   return "H3";
      case PERIOD_H4:   return "H4";
      case PERIOD_H6:   return "H6";
      case PERIOD_H8:   return "H8";
      case PERIOD_H12:  return "H12";
      case PERIOD_D1:   return "D1";
      case PERIOD_W1:   return "W1";
      case PERIOD_MN1:  return "MN1";
      default:          return IntegerToString((int)timeframe);
   }
}

bool CreateMonitorLabel()
{
   if(ObjectFind(0, g_monitorName) >= 0)
      return true;

   if(!ObjectCreate(0, g_monitorName, OBJ_LABEL, 0, 0, 0))
      return false;

   ObjectSetInteger(0, g_monitorName, OBJPROP_CORNER, InpMonitorCorner);
   ObjectSetInteger(0, g_monitorName, OBJPROP_XDISTANCE, InpMonitorX);
   ObjectSetInteger(0, g_monitorName, OBJPROP_YDISTANCE, InpMonitorY);
   ObjectSetInteger(0, g_monitorName, OBJPROP_FONTSIZE, 10);
   ObjectSetInteger(0, g_monitorName, OBJPROP_COLOR, clrWhite);
   ObjectSetString(0, g_monitorName, OBJPROP_FONT, "Consolas");
   return true;
}

void DrawSignalLine(const datetime signalTime)
{
   const string lineName = g_linePrefix + StringFormat("%I64d", (long)signalTime);

   if(ObjectFind(0, lineName) >= 0)
      return;

   if(!ObjectCreate(0, lineName, OBJ_VLINE, 0, signalTime, 0.0))
      return;

   ObjectSetInteger(0, lineName, OBJPROP_COLOR, InpLineColor);
   ObjectSetInteger(0, lineName, OBJPROP_STYLE, InpLineStyle);
   ObjectSetInteger(0, lineName, OBJPROP_WIDTH, InpLineWidth);
   ObjectSetInteger(0, lineName, OBJPROP_BACK, false);
}

void UpdateMonitor(const double currentForceValue)
{
   const ENUM_TIMEFRAMES timeframe = ResolveTimeframe();
   string stateText = "BELOW";
   if(currentForceValue > InpTriggerValue)
      stateText = "ABOVE";

   const string monitorText =
      "Force Index Monitor\n" +
      "Timeframe: " + TimeframeToString(timeframe) + "\n" +
      "Current FI: " + DoubleToString(currentForceValue, 2) + "\n" +
      "Trigger: " + DoubleToString(InpTriggerValue, 2) + "\n" +
      "State: " + stateText;

   if(ObjectFind(0, g_monitorName) < 0)
      CreateMonitorLabel();

   ObjectSetString(0, g_monitorName, OBJPROP_TEXT, monitorText);
}

void CheckTriggerCrossDown()
{
   double forceValues[3];
   datetime barTimes[3];
   ArraySetAsSeries(forceValues, true);
   ArraySetAsSeries(barTimes, true);

   if(CopyBuffer(g_forceHandle, 0, 0, 3, forceValues) < 3)
      return;

   if(CopyTime(_Symbol, ResolveTimeframe(), 0, 3, barTimes) < 3)
      return;

   UpdateMonitor(forceValues[0]);

   const bool crossedDown = (forceValues[2] > InpTriggerValue && forceValues[1] <= InpTriggerValue);
   if(!crossedDown)
      return;

   const datetime signalBarTime = barTimes[1];
   if(signalBarTime == g_lastAlertBarTime)
      return;

   g_lastAlertBarTime = signalBarTime;

   DrawSignalLine(signalBarTime);

   if(InpEnableAlerts)
   {
      const string message =
         "Force Index crossed down trigger on " + _Symbol +
         " [" + TimeframeToString(ResolveTimeframe()) + "]" +
         ". FI=" + DoubleToString(forceValues[1], 2) +
         ", Trigger=" + DoubleToString(InpTriggerValue, 2) +
         ", Time=" + TimeToString(signalBarTime, TIME_DATE | TIME_MINUTES);
      Alert(message);
      Print(message);
   }
}

int OnInit()
{
   g_forceHandle = iForce(_Symbol, ResolveTimeframe(), InpForcePeriod, InpMaMethod, InpVolumeType);
   if(g_forceHandle == INVALID_HANDLE)
   {
      Print("Failed to create Force Index handle. Error: ", GetLastError());
      return(INIT_FAILED);
   }

   if(!CreateMonitorLabel())
   {
      Print("Failed to create monitor label. Error: ", GetLastError());
      return(INIT_FAILED);
   }

   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   if(g_forceHandle != INVALID_HANDLE)
   {
      IndicatorRelease(g_forceHandle);
      g_forceHandle = INVALID_HANDLE;
   }

   ObjectDelete(0, g_monitorName);
}

void OnTick()
{
   if(g_forceHandle == INVALID_HANDLE)
      return;

   CheckTriggerCrossDown();
}
